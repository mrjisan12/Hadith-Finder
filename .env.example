# =============================================================================
# Hadith Finder - environment configuration (backend + ingestion).
# Copy to `.env` and fill in. NEVER commit `.env`. The frontend needs no secrets
# (see frontend/.env.example).
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO
# Exposes retrieval diagnostics + /api/v1/debug/* endpoints. Set false in production.
ENABLE_DEBUG=true

# ----------------------------------------------------------------- Database
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the pooler URI (port 6543) for the deployed API; either works locally.
# Local Docker (docker compose up db): postgresql://postgres:postgres@localhost:5432/hadith
DATABASE_URL=

# ----------------------------------------------------------------- Storage
# local = files under ./data (served by the API) | supabase = Supabase Storage bucket
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: backend/ingestion only - never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=books
STORAGE_PUBLIC=true

# ----------------------------------------------------------------- LLM
# anthropic (default) | openai (also any OpenAI-compatible API via LLM_BASE_URL)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-opus-5
# Model for query rewriting + reranking; empty = same as LLM_MODEL.
LLM_FAST_MODEL=
LLM_ANSWER_EFFORT=medium
LLM_FAST_EFFORT=low

# ----------------------------------------------------------------- Embeddings
# gemini | openai | cohere | voyage | local   (see docs/ARCHITECTURE.md for trade-offs)
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Empty = provider default (gemini-embedding-001, text-embedding-3-large, embed-multilingual-v3.0, voyage-3.5, BAAI/bge-m3)
EMBEDDING_MODEL=
# Fixed at migration time. 1024 works for every provider above.
EMBEDDING_DIM=1024

# ----------------------------------------------------------------- Reranker
# llm (uses LLM_API_KEY) | cohere | jina | none
RERANKER_PROVIDER=llm
RERANKER_API_KEY=
RERANKER_MODEL=
# Empty = provider default threshold (llm 0.5, cohere 0.15, jina 0.2)
RERANK_MIN_SCORE=

# ----------------------------------------------------------------- OCR (ingestion only)
# google_vision (recommended for Bangla) | tesseract (free, offline, lower accuracy)
OCR_PROVIDER=google_vision
GOOGLE_VISION_API_KEY=
TESSERACT_CMD=

# ----------------------------------------------------------------- Security / infra
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_CHAT=20/minute
# Optional; enables shared rate-limit storage across instances.
REDIS_URL=
